{
  "name": "appium-xa11y-driver",
  "version": "0.1.0",
  "description": "Appium driver for native desktop apps on macOS, Windows and Linux, built on xa11y",
  "license": "MIT",
  "keywords": [
    "appium",
    "desktop",
    "accessibility",
    "automation",
    "macos",
    "windows",
    "linux"
  ],
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "files": [
    "build/src",
    "README.md",
    "LICENSE"
  ],
  "appium": {
    "driverName": "xa11y",
    "automationName": "Xa11y",
    "platformNames": [
      "Mac",
      "Windows",
      "Linux"
    ],
    "mainClass": "Xa11yDriver"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && tsc -p .",
    "conformance": "npm run build && node scripts/conformance.mjs",
    "test": "npm run conformance --"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "appium": "^3.0.0"
  },
  "dependencies": {
    "@crowecawcaw/xa11y": "0.15.4",
    "@xmldom/xmldom": "^0.9.12",
    "xpath": "^0.0.36"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "appium": "^3.5.2",
    "typescript": "^5.9.0"
  }
}
